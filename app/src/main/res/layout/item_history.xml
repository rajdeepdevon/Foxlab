<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingBottom="8dp">

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview6"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		app:cardBackgroundColor="#1A1D2E"
		app:cardCornerRadius="16dp"
		app:strokeColor="#2A2F45"
		app:strokeWidth="1dp"
		app:cardElevation="0dp">

		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="12dp">

			<!-- Play Button (Rounded Square) -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/btn_play_item"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_centerVertical="true"
				app:cardBackgroundColor="#252A40"
				app:cardCornerRadius="12dp"
				app:strokeColor="#2A2F45"
				app:strokeWidth="1dp"
				app:cardElevation="0dp">
				
				<ImageView
					android:id="@+id/img_play_pause"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:padding="12dp"
					android:src="@drawable/icon_play_circle"
					android:scaleType="fitCenter"
					app:tint="#F1F5F9" />
			</com.google.android.material.card.MaterialCardView>

			<!-- More Options (3 Dots / Share) -->
			<ImageView
				android:id="@+id/btn_share"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:layout_alignParentEnd="true"
				android:layout_centerVertical="true"
				android:src="@drawable/icon_ios_share"
				android:scaleType="fitCenter"
				app:tint="#94A3B8"
				android:background="?attr/selectableItemBackground" />

			<!-- Heart Icon -->
			<ImageView
				android:id="@+id/btn_favorite"
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="16dp"
				android:layout_toStartOf="@id/btn_share"
				android:layout_centerVertical="true"
				android:src="@drawable/icon_favorite_outline"
				android:scaleType="fitCenter"
				app:tint="#EF4444"
				android:background="?attr/selectableItemBackground" />

			<!-- Details Area -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				android:layout_toStartOf="@id/btn_favorite"
				android:layout_toEndOf="@id/btn_play_item"
				android:layout_centerVertical="true">

				<!-- Title -->
				<TextView
					android:id="@+id/txt_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Narration_01.mp5"
					android:textSize="15sp"
					android:textStyle="bold"
					android:textColor="#F1F5F9"
					android:ellipsize="end"
					android:maxLines="1" />

				<!-- Date/Time -->
				<TextView
					android:id="@+id/txt_meta"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="Date 02:51, 2024"
					android:textSize="11sp"
					android:textColor="#94A3B8" />

				<!-- Voice Name & Dummy Waveform -->
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<!-- Voice Name -->
					<TextView
						android:id="@+id/txt_voice_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Bella (English)"
						android:textSize="11sp"
						android:textColor="#4A9EFF"
						android:ellipsize="end"
						android:maxLines="1"
						android:layout_marginEnd="8dp"/>
						
					<!-- Dummy Waveform Graphic -->
					<ImageView
						android:layout_width="0dp"
						android:layout_height="20dp"
						android:layout_weight="1"
						android:src="@drawable/icon_graphic_eq"
						android:scaleType="fitXY"
						app:tint="#2A2F45" />

				</LinearLayout>
			</LinearLayout>
		</RelativeLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
