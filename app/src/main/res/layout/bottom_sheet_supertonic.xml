<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="20dp"
	android:paddingTop="20dp"
	android:paddingEnd="20dp"
	android:paddingBottom="24dp"
	android:background="#070B14">
	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Language"
		android:textColor="#94A3B8"
		android:textSize="12sp"
		android:textStyle="bold" />
	<Spinner
		android:id="@+id/supertonic_language_spinner"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginTop="6dp"
		android:background="#121826"
		android:paddingHorizontal="12dp"
		android:spinnerMode="dropdown"
		android:popupBackground="#121826" />
	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="8dp"
		android:text="Supertonic voice styles"
		android:textColor="#94A3B8"
		android:textSize="12sp"
		android:textStyle="bold" />
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:maxHeight="420dp"
		android:fillViewport="false"
		android:scrollbars="vertical">
		<LinearLayout
			android:id="@+id/supertonic_voice_list"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical" />
	</ScrollView>
</LinearLayout>
