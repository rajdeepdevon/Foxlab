<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#0F1117"
	android:orientation="vertical"
	android:padding="16dp">

	<!-- Top Bar -->
	<RelativeLayout
		android:id="@+id/relativelayout20"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="20dp">
		
		<ImageView
			android:id="@+id/img_logo"
			android:layout_width="26dp"
			android:layout_height="26dp"
			android:src="@drawable/icon_graphic_eq"
			android:scaleType="fitCenter"
			app:tint="#4A9EFF" />
			
		<TextView
			android:id="@+id/title_tv"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="TTS Console"
			android:textSize="20sp"
			android:textStyle="bold"
			android:textColor="#F1F5F9"
			android:layout_marginStart="12dp"
			android:layout_toEndOf="@id/img_logo"
			android:layout_centerVertical="true" />
			
		<LinearLayout
			android:id="@+id/top_actions"
			android:layout_width="wrap_content"
			android:layout_height="40dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:layout_alignParentEnd="true"
			android:layout_centerVertical="true">
			
			<ImageView
				android:id="@+id/history"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:padding="6dp"
				android:contentDescription="History"
				android:background="?attr/selectableItemBackground"
				android:src="@drawable/icon_history"
				android:scaleType="fitCenter"
				app:tint="#94A3B8" />
				
			<ImageView
				android:id="@+id/dictionary"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:padding="6dp"
				android:contentDescription="Pronunciation lexicon"
				android:background="?attr/selectableItemBackground"
				android:src="@drawable/icon_menu_book"
				android:scaleType="fitCenter"
				app:tint="#94A3B8" />
				
			<ImageView
				android:id="@+id/save"
				android:layout_width="36dp"
				android:layout_height="36dp"
				android:padding="5dp"
				android:contentDescription="Save audio"
				android:background="?attr/selectableItemBackground"
				android:src="@drawable/icon_save"
				android:scaleType="fitCenter"
				app:tint="#94A3B8" />
		</LinearLayout>
	</RelativeLayout>

	<!-- Input Text Label -->
	<RelativeLayout
		android:id="@+id/relativelayout21"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<TextView
			android:id="@+id/textview55"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="INPUT TEXT"
			android:textSize="12sp"
			android:textStyle="bold"
			android:textColor="#94A3B8"
			android:letterSpacing="0.05" />
	</RelativeLayout>

	<!-- Input Text Box -->
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardview26"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_marginTop="8dp"
		app:cardBackgroundColor="#1A1D2E"
		android:layout_weight="1"
		app:cardCornerRadius="16dp"
		app:strokeColor="#2A2F45"
		app:strokeWidth="1dp"
		app:cardElevation="0dp">
		
		<FrameLayout
			android:id="@+id/input_relativelayout"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingLeft="12dp"
			android:paddingTop="12dp"
			android:paddingRight="12dp">
			
			<ScrollView
				android:id="@+id/vscroll4"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:fillViewport="true"
				android:scrollbars="vertical"
				android:fadeScrollbars="false"
				android:overScrollMode="always">
				<EditText
					android:id="@+id/et_input"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingBottom="64dp"
					android:textSize="16sp"
					android:textColor="#F1F5F9"
					android:hint="Write something to convert into audio..."
					android:textColorHint="#64748B"
					android:gravity="top|start"
					android:background="@null"
					android:inputType="textMultiLine"
					android:minHeight="100dp"
					android:paddingStart="16dp"
					android:paddingEnd="16dp" />
			</ScrollView>
			
			<LinearLayout
				android:id="@+id/input_quick_actions"
				android:layout_width="wrap_content"
				android:layout_height="44dp"
				android:layout_marginBottom="16dp"
				android:layout_gravity="bottom|end"
				android:layout_marginEnd="16dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/card_add"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_marginEnd="6dp"
					app:cardBackgroundColor="#252A40"
					app:cardCornerRadius="10dp"
					app:strokeWidth="0dp"
					android:focusable="true"
					android:foreground="?attr/selectableItemBackground">
					<ImageView
						android:id="@+id/imageview62"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="10dp"
						android:contentDescription="Import document"
						android:src="@drawable/icon_note_add"
						android:scaleType="fitCenter"
						app:tint="#94A3B8" />
				</com.google.android.material.card.MaterialCardView>
				
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/btn_voice_input"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_marginEnd="6dp"
					android:contentDescription="Voice typing"
					android:focusable="true"
					android:foreground="?attr/selectableItemBackground"
					app:cardBackgroundColor="#252A40"
					app:cardCornerRadius="10dp"
					app:strokeWidth="0dp">
					<ImageView
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="10dp"
						android:src="@drawable/icon_mic"
						android:scaleType="fitCenter"
						app:tint="#94A3B8" />
				</com.google.android.material.card.MaterialCardView>
				
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/btn_paste"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_marginEnd="6dp"
					android:contentDescription="Paste from clipboard"
					android:focusable="true"
					android:foreground="?attr/selectableItemBackground"
					app:cardBackgroundColor="#252A40"
					app:cardCornerRadius="10dp"
					app:strokeWidth="0dp">
					<ImageView
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="10dp"
						android:src="@drawable/icon_content_paste"
						android:scaleType="fitCenter"
						app:tint="#94A3B8" />
				</com.google.android.material.card.MaterialCardView>
				
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/btn_clear_text"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:contentDescription="Clear text"
					android:focusable="true"
					android:foreground="?attr/selectableItemBackground"
					app:cardBackgroundColor="#252A40"
					app:cardCornerRadius="10dp"
					app:strokeWidth="0dp">
					<ImageView
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="10dp"
						android:src="@drawable/icon_delete"
						android:scaleType="fitCenter"
						app:tint="#94A3B8" />
				</com.google.android.material.card.MaterialCardView>
			</LinearLayout>
		</FrameLayout>
	</com.google.android.material.card.MaterialCardView>

	<!-- ONNX Voice Model Label -->
	<TextView
		android:id="@+id/textview67"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:text="ONNX VOICE MODEL"
		android:textSize="12sp"
		android:textStyle="bold"
		android:textColor="#94A3B8" />
		
	<!-- ONNX Voice Model Card -->
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/voice_info_card"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:layout_marginTop="10dp"
		app:cardBackgroundColor="#1A1D2E"
		app:cardCornerRadius="12dp"
		app:strokeColor="#2A2F45"
		app:strokeWidth="1dp"
		app:cardElevation="0dp">
		
		<LinearLayout
			android:id="@+id/linear53"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center_vertical"
			android:paddingHorizontal="16dp">
			
			<ImageView
				android:id="@+id/imageview63"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:src="@drawable/icon_record_voice"
				android:scaleType="fitCenter"
				app:tint="#4A9EFF" />
				
			<TextView
				android:id="@+id/voice_name_tv"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="No Model selected"
				android:textSize="16sp"
				android:textColor="#F1F5F9"
				android:layout_weight="1" />
				
			<ImageView
				android:id="@+id/opne_dropdown"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="8dp"
				android:background="?attr/selectableItemBackground"
				android:src="@drawable/icon_keyboard_arrow"
				android:scaleType="fitCenter"
				app:tint="#94A3B8" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<!-- Kokoro Voice Filters (Hidden by default) -->
	<LinearLayout
		android:id="@+id/kokoro_voice_filters"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:orientation="horizontal"
		android:visibility="gone">
		
		<com.google.android.material.card.MaterialCardView
			android:layout_width="0dp"
			android:layout_height="56dp"
			android:layout_weight="1"
			android:layout_marginEnd="4dp"
			app:cardBackgroundColor="#1A1D2E"
			app:cardCornerRadius="12dp"
			app:strokeColor="#2A2F45"
			app:strokeWidth="1dp"
			app:cardElevation="0dp">
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:gravity="center_vertical"
				android:paddingHorizontal="8dp">
				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="REGION"
					android:textColor="#94A3B8"
					android:textSize="10sp"
					android:textStyle="bold"
					android:letterSpacing="0.05" />
				<Spinner
					android:id="@+id/kokoro_region_spinner"
					android:layout_width="match_parent"
					android:layout_height="34dp"
					android:spinnerMode="dropdown"
					android:popupBackground="#1A1D2E" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		
		<com.google.android.material.card.MaterialCardView
			android:layout_width="0dp"
			android:layout_height="56dp"
			android:layout_weight="1"
			android:layout_marginStart="4dp"
			app:cardBackgroundColor="#1A1D2E"
			app:cardCornerRadius="12dp"
			app:strokeColor="#2A2F45"
			app:strokeWidth="1dp"
			app:cardElevation="0dp">
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:gravity="center_vertical"
				android:paddingHorizontal="8dp">
				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="VOICE"
					android:textColor="#94A3B8"
					android:textSize="10sp"
					android:textStyle="bold"
					android:letterSpacing="0.05" />
				<Spinner
					android:id="@+id/kokoro_voice_spinner"
					android:layout_width="match_parent"
					android:layout_height="34dp"
					android:spinnerMode="dropdown"
					android:popupBackground="#1A1D2E" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
	</LinearLayout>

	<!-- Supertonic Controls (Hidden by default) -->
	<LinearLayout
		android:id="@+id/supertonic_controls_layout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:orientation="horizontal"
		android:visibility="gone">
		
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/supertonic_voice_button"
			android:layout_width="0dp"
			android:layout_height="50dp"
			android:layout_weight="1"
			android:layout_marginEnd="4dp"
			android:contentDescription="Choose Supertonic voice and language"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground"
			app:cardBackgroundColor="#1A1D2E"
			app:cardCornerRadius="12dp"
			app:strokeColor="#2A2F45"
			app:strokeWidth="1dp"
			app:cardElevation="0dp">
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_vertical"
				android:paddingStart="12dp"
				android:paddingEnd="8dp">
				<TextView
					android:id="@+id/supertonic_voice_value"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center_vertical"
					android:text="Supertonic • F1 English"
					android:textColor="#F1F5F9"
					android:textSize="14sp"
					android:maxLines="1"
					android:ellipsize="end" />
				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/icon_keyboard_arrow"
					android:scaleType="fitCenter"
					app:tint="#94A3B8" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
		
		<com.google.android.material.card.MaterialCardView
			android:id="@+id/supertonic_settings_button"
			android:layout_width="50dp"
			android:layout_height="50dp"
			android:layout_marginStart="4dp"
			android:contentDescription="Generation quality settings"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?attr/selectableItemBackground"
			app:cardBackgroundColor="#1A1D2E"
			app:cardCornerRadius="12dp"
			app:strokeColor="#2A2F45"
			app:strokeWidth="1dp"
			app:cardElevation="0dp">
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_vertical"
				android:paddingStart="12dp"
				android:paddingEnd="12dp">
				<ImageView
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:src="@drawable/icon_settings"
					android:scaleType="fitCenter"
					app:tint="#4A9EFF" />
			</LinearLayout>
		</com.google.android.material.card.MaterialCardView>
	</LinearLayout>

	<!-- ================= SYNTHESIS BAR (TARGET DESIGN) ================= -->
	<com.google.android.material.card.MaterialCardView
		android:layout_width="match_parent"
		android:layout_height="46dp"
		android:layout_marginTop="12dp"
		app:cardBackgroundColor="#1A1D2E"
		app:strokeColor="#2A2F45"
		app:strokeWidth="1dp"
		app:cardCornerRadius="12dp"
		app:cardElevation="0dp">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center"
			android:orientation="horizontal">
			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:src="@drawable/icon_graphic_eq"
				app:tint="#4A9EFF" />
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="SYNTHESIS"
				android:textColor="#F1F5F9"
				android:textSize="14sp"
				android:textStyle="bold"
				android:letterSpacing="0.1"
				android:layout_marginStart="8dp" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
	<!-- ================================================================ -->

	<!-- Status Box -->
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/card_status"
		android:layout_width="match_parent"
		android:layout_height="130dp"
		android:layout_marginTop="12dp"
		app:cardBackgroundColor="#1A1D2E"
		app:cardCornerRadius="16dp"
		app:strokeColor="#2A2F45"
		app:strokeWidth="1dp"
		app:cardElevation="0dp">
		
		<RelativeLayout
			android:id="@+id/relativelayout2"
			android:layout_width="match_parent"
			android:layout_height="match_parent">
			
			<LinearLayout
				android:id="@+id/layout_idle_state"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:layout_centerInParent="true">
				
				<ImageView
					android:id="@+id/imageview65"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/icon_graphic_eq"
					android:scaleType="fitCenter"
					app:tint="#4A9EFF" />
					
				<ProgressBar
					android:id="@+id/progress_generating"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:indeterminate="false"
					style="?android:progressBarStyle"
					android:visibility="gone"
					android:indeterminateTint="#4A9EFF" />
					
				<TextView
					android:id="@+id/textview69"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:text="READY TO SYNTHESIZE"
					android:textSize="12sp"
					android:textStyle="bold"
					android:textColor="#4A9EFF"
					android:letterSpacing="0.05" />
			</LinearLayout>
			
			<RelativeLayout
				android:id="@+id/layout_generated_state"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="16dp"
				android:visibility="gone">
				
				<ImageView
					android:id="@+id/img_waveform"
					android:layout_width="match_parent"
					android:layout_height="60dp"
					android:layout_marginTop="5dp"
					android:src="@drawable/default_image"
					android:scaleType="fitCenter"
					app:tint="#4A9EFF"
					android:layout_centerHorizontal="true"
					android:layout_alignParentTop="true" />
					
				<View
					android:id="@+id/playhead_line"
					android:layout_width="2dp"
					android:layout_height="60dp"
					android:layout_marginTop="5dp"
					android:background="#8B5CF6"
					android:elevation="2dp"
					android:visibility="gone"
					android:layout_alignParentTop="true"
					android:layout_alignParentStart="true" />
					
				<TextView
					android:id="@+id/tv_duration"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="0:24 seconds"
					android:textSize="13sp"
					android:textColor="#94A3B8"
					android:layout_alignParentBottom="true"
					android:layout_alignParentStart="true" />
					
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/btn_export"
					android:layout_width="36dp"
					android:layout_height="36dp"
					app:cardBackgroundColor="#252A40"
					app:cardCornerRadius="8dp"
					app:strokeWidth="0dp"
					android:layout_alignParentBottom="true"
					android:layout_alignParentEnd="true">
					<ImageView
						android:id="@+id/imageview2"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:padding="8dp"
						android:background="?attr/selectableItemBackground"
						android:src="@drawable/icon_ios_share"
						android:scaleType="fitXY"
						app:tint="#94A3B8" />
				</com.google.android.material.card.MaterialCardView>
			</RelativeLayout>
		</RelativeLayout>
	</com.google.android.material.card.MaterialCardView>

	<!-- Generate Button with Gradient -->
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/btn_generate"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="8dp"
		app:cardBackgroundColor="@android:color/transparent"
		app:cardCornerRadius="25dp"
		app:cardElevation="6dp"
		app:strokeWidth="0dp"
		android:focusable="true"
		android:foreground="?attr/selectableItemBackground">
		
		<LinearLayout
			android:id="@+id/linear54"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@drawable/bg_gradient_btn"
			android:gravity="center_horizontal|center_vertical">
			
			<ImageView
				android:id="@+id/imageview52"
				android:layout_width="25dp"
				android:layout_height="25dp"
				android:padding="2dp"
				android:src="@drawable/icon_play_circle"
				android:scaleType="fitCenter"
				app:tint="#FFFFFF" />
				
			<TextView
				android:id="@+id/textview92"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Generate &amp; Play"
				android:textSize="18sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

</LinearLayout>
